# Copy to .dev.vars for `npm run dev`. Leave NVIDIA_API_KEY empty to use mock outputs on localhost.
NVIDIA_API_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Optional: any long random value. Send it as the x-health-token header to get the full /api/health report.
HEALTH_TOKEN=
